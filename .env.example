# Copie este arquivo para .env (que fica fora do Git) e preencha com os seus dados.
# Na nuvem (Render/Railway), cadastre as mesmas variáveis no painel do serviço.

DB_URL=jdbc:oracle:thin:@oracle.fiap.com.br:1521:ORCL
DB_USERNAME=rmXXXXXX
DB_PASSWORD=sua_senha

# Chave do token de acesso: texto aleatório com 32 caracteres ou mais
JWT_SECRET=troque-por-um-texto-aleatorio-com-32-caracteres-ou-mais

# Origens do front liberadas no CORS (separadas por vírgula)
CORS_ORIGENS=http://localhost:5173,https://*.vercel.app
